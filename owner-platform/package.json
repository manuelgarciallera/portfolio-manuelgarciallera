{
  "name": "portfolio-owner-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "node ./scripts/build.mjs",
    "check": "npm run test && npm run test:integration && npm run lint && npm run typecheck && npm run build",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "graphql": "16.11.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "20.19.14",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.28.2",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.14"
    }
  }
}
