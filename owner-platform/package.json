{
  "name": "portfolio-owner-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/lexical-field-patch.mjs",
    "dev": "node ./scripts/dev.mjs",
    "build": "node ./scripts/build.mjs",
    "check": "npm run test && npm run test:integration && npm run lint && npm run typecheck && npm run build",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "eslint .",
    "start": "next start",
    "test": "node ./scripts/lexical-field-patch.mjs && node --test tests/lexical-field-patch.test.mjs tests/local-editor-assets.test.mjs tests/build-preserves-dev.test.mjs tests/build-environment.test.mjs && vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:postgres": "node scripts/test-integration-postgres.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:recovery:postgres": "node scripts/test-recovery-postgres.mjs",
    "test:controls": "node tests/document-controls.browser.mjs",
    "test:dashboard": "node tests/dashboard.browser.mjs",
    "test:production:editor": "node scripts/test-production-http.mjs --browser-editor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "graphql": "16.11.0",
    "monaco-editor": "0.56.0",
    "next": "16.3.4",
    "payload": "3.89.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "20.19.14",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.28.2",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.4",
    "playwright": "1.62.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "monaco-editor": {
      "dompurify": "3.4.14"
    }
  }
}
