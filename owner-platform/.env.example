PAYLOAD_SECRET=
# Production: explicit HTTPS origin for owner links, e.g. https://cms.example.com
# Local QA may set http://127.0.0.1:3013. Never use the public portfolio URL here.
OWNER_SERVER_URL=
# Owner-only Resend credential and verified plain sender address; never NEXT_PUBLIC.
OWNER_EMAIL_API_KEY=
OWNER_EMAIL_FROM=
DATABASE_URL=
LOCAL_DATABASE_NAME=
OWNER_BOOTSTRAP_SECRET=
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_PLAN=starter

# Leave unset for existing legacy libraries. Do not switch existing data without
# a reviewed schema/data migration and restorable backup. No automatic fallback.
# objects needs ALL fields below and canonical OWNER_SERVER_URL, also at build.
# Scratch directory must already exist, outside public/static mounts.
OWNER_MEDIA_MODE=
OWNER_MEDIA_ENDPOINT=
OWNER_MEDIA_REGION=
OWNER_MEDIA_BUCKET=
OWNER_MEDIA_PREFIX=
OWNER_MEDIA_ACCESS_KEY_ID=
OWNER_MEDIA_SECRET_ACCESS_KEY=
OWNER_MEDIA_SCRATCH_DIR=
