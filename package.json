    "@splinetool/react-spline": "^4.1.0",
    "framer-motion": "^12.35.1",
    "gsap": "^3.14.2",
    "lenis": "^1.3.18",
    "next": "^16.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.183.2",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
