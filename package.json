  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-restart.ps1",
    "build": "next build",
    "start": "next start",
    "check:encoding": "node ./scripts/check-encoding.mjs",
    "check:hero": "node ./scripts/check-hero-structure.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:security": "npm audit --omit=dev",
    "audit:lighthouse:desktop": "node ./scripts/lighthouse-audit.mjs desktop",
    "audit:lighthouse:mobile": "node ./scripts/lighthouse-audit.mjs mobile",
    "check:all": "npm run check:encoding && npm run check:hero && npm run lint && npm run typecheck && npm run build && npm run audit:security",
    "sync:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-preview.ps1",
    "ship": "bash ./scripts/ship.sh"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
