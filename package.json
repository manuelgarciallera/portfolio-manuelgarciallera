{
  "name": "portfolio-manuelgarciallera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-restart.ps1",
    "build": "next build",
    "start": "next start",
    "check:encoding": "node ./scripts/check-encoding.mjs",
    "check:hero": "node ./scripts/check-hero-structure.mjs",
    "check:responsive-type": "node ./scripts/check-responsive-typography.mjs",
    "check:mobile-nav": "node ./scripts/check-mobile-navigation.mjs",
    "check:public-boundary": "node ./scripts/check-public-boundary.mjs",
    "check:public-bundle": "node ./scripts/check-public-bundle.mjs",
    "test:public-guards": "node --test ./scripts/tests/public-guards.test.mjs",
    "check:responsive": "npm run check:responsive-type && npm run check:mobile-nav",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:security": "npm audit --omit=dev",
    "audit:lighthouse:desktop": "node ./scripts/lighthouse-audit.mjs desktop",
    "audit:lighthouse:mobile": "node ./scripts/lighthouse-audit.mjs mobile",
    "check:all": "npm run check:encoding && npm run check:hero && npm run check:responsive && npm run lint && npm run typecheck && npm run build && npm run audit:security",
    "sync:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-preview.ps1",
    "ship": "bash ./scripts/ship.sh",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@splinetool/react-spline": "^4.1.0",
    "framer-motion": "^12.35.1",
    "gsap": "^3.14.2",
    "lenis": "^1.3.18",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.3",
    "simple-icons": "^16.29.0",
    "three": "^0.183.2",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/nextjs-vite": "^10.5.4",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-storybook": "^10.5.4",
    "playwright": "^1.62.0",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "sharp": "0.35.3"
  }
}
